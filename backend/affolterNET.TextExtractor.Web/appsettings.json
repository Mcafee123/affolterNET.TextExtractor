{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "StorageAccountName": "placeholder-storage-account",
  "StorageAccountKey": "placeholder-storage-key-configure-in-secrets",
  "affolterNET": {
    "Web": {
      "BffOptions": {
        "BackendUrl": "http://localhost:5000",
        "FrontendUrl": "http://localhost:5000"
      },
      "Auth": {
        "Provider": {
          "AuthorityBase": "https://your-keycloak-server.com",
          "Realm": "textextractor",
          "ClientId": "textextractor-client",
          "ClientSecret": "PLACEHOLDER-CONFIGURE-IN-SECRETS"
        },
        "Scopes": ["openid", "profile", "email"]
      }
    }
  }
}
