{
  "affolterNET": {
    "Web": {
      "BffOptions": {
        "BackendUrl": "https://localhost:5000"
      },
      "Auth": {
        "Provider": {
          "AuthorityBase": "https://idpdev.affolter.net",
          "Realm": "affolter.NET"
        }
      },
      "Swagger": {
        "Enabled": false,
        "Title": "TextExtractor API",
        "Version": "v1",
        "Description": "PDF text extraction API"
      }
    }
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
