{
  "affolterNET": {
    "Web": {
      "BffOptions": {
        "FrontendUrl": "https://localhost:5173"
      },
      "Swagger": {
        "Enabled": true
      },
      "SecurityHeaders": {
        "CustomCspDirectives": {
          "script-src": "'self' 'unsafe-inline' 'unsafe-eval' https://localhost:5173",
          "script-src-elem": "'self' 'unsafe-inline' https://localhost:5173",
          "style-src": "'self' 'unsafe-inline' https://localhost:5173",
          "style-src-elem": "'self' 'unsafe-inline' https://localhost:5173",
          "connect-src": "'self' https://localhost:5173 wss://localhost:5173"
        }
      }
    },
    "TextExtractor": {
      "StorageSettings": {
        "ConnectionString": "UseDevelopmentStorage=true"
      }
    },
    "ReverseProxy": {
      "Clusters": {
        "localdevcluster": {
          "Destinations": {
            "localdevcluster/destination1": {
              "Address": "https://localhost:5173/"
            }
          },
          "HttpClient": {
            "SslProtocols": [
              "Tls12"
            ],
            "DangerousAcceptAnyServerCertificate": true
          }
        }
      },
      "Routes": {
        "localdev": {
          "ClusterId": "localdevcluster",
          "Match": {
            "Path": "{**catch-all}"
          },
          "Metadata": {
            "Microsoft.AspNetCore.Authorization.AllowAnonymous": "true"
          },
          "Transforms": [
            {
              "RequestHeader": "X-Forwarded-Host",
              "Set": "localhost:5000"
            }
          ],
          "Order": 1000
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.AspNetCore.Authorization": "Debug",
      "Yarp.ReverseProxy": "Debug"
    }
  }
}
