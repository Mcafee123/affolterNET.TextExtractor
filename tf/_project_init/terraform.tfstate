          "attributes": {
            "content": "#!/bin/bash\n\n# author: martin@affolter.net\n\n# DO NOT CHANGE MANUALLY - GENERATED BY STATEFILES GENERATOR MODULE\n\nyellow() { printf \"\\e[33m$*\\e[0m\\n\"; }\ngreen() { printf  \"\\e[32m$*\\e[0m\\n\"; }\nred() { printf  \"\\e[31m$*\\e[0m\\n\"; }\nblue() { printf \"\\e[34m$*\\e[0m\\n\"; }\n\nenv=${1:-\"dev\"}\nclient_id=\"$(az keyvault secret show --name an-platform-state-${env}-sp-client-id --vault-name affolternet-vault --query value -o tsv)\"\n\n# Check if already logged in with the desired client_id\ncurrent_client_id=\"$(az account show --query user.name -o tsv 2\u003e/dev/null || echo \"\")\"\n\nif [ \"$current_client_id\" = \"$client_id\" ]; then\n    green \"Already logged in with client_id: $client_id for environment: $env\"\n    exit 0\nfi\n\nclient_secret=\"$(az keyvault secret show --name an-platform-state-${env}-sp-client-secret --vault-name affolternet-vault --query value -o tsv)\"\naz login --service-principal -u $client_id -p $client_secret --tenant 9c0f6304-c41a-4891-8379-ed3cbfc54535\n\nyellow \"logged in to \\\"$env\\\"\"",
            "content_base64": null,
