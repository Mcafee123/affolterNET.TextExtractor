        {
          "index_key": "app-dev",
          "schema_version": 0,
          "attributes": {
            "content": "#!/bin/bash\n\n# author: martin@affolter.net\n\n# DO NOT CHANGE MANUALLY - GENERATED BY STATEFILES GENERATOR MODULE\n\nyellow() { printf \"\\e[33m$*\\e[0m\\n\"; }\ngreen() { printf  \"\\e[32m$*\\e[0m\\n\"; }\nred() { printf  \"\\e[31m$*\\e[0m\\n\"; }\nblue() { printf \"\\e[34m$*\\e[0m\\n\"; }\n\n# Check if already logged in with the desired client_id\nclient_id=\"5700c6f1-4c18-44db-962d-a7d437d1b424\"\ncurrent_client_id=\"$(az account show --query user.name -o tsv 2\u003e/dev/null || echo \"\")\"\n\nif [ \"$current_client_id\" != \"$client_id\" ]; then\n    red \"Wrong client_id: $current_client_id. Please run 'az login' first.\"\n    exit 0\nfi\n# set the correct subscription\naz account set --subscription \"93a208c4-9c58-4f97-b35f-9beb52df1041\"\n\nterraform init -backend-config=_backend.hcl -reconfigure\n\nyellow \"Initialized Terraform for module: text-e/dev/app\"",
